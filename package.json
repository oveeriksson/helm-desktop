{
  "name": "helm-browser",
  "version": "1.1.4",
  "description": "Helm native desktop browser",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:dev": "electron . --helm-dev",
    "desktop:pack": "electron-builder --dir --config electron-builder.yml",
    "desktop:mac": "electron-builder --mac --config electron-builder.yml",
    "desktop:win": "electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  }
}
